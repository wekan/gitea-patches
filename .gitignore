.tools/
__pycache__/
/gitea/
/out/
# gitea-to-gitlab / gitea-to-sourceforge: settings with tokens, progress, run logs,
# and their git work copies are this machine's, never committed.
mirror/gitea-to-*/*.ini
mirror/gitea-to-*/*.ini.tmp
mirror/gitea-to-*/*-state.json*
mirror/gitea-to-*/log/
mirror/gitea-to-*/work/
# github-to-gitea: its git cache of pull request heads pushed to Gitea.
mirror/github-to-gitea/tmp/
# Every run's log beside its script: <name>_YYYY-MM-DD_HH-MM-SS-log.txt.
*log.txt
