 modules/setting/repository.go          |  2 +-
 modules/setting/repository_test.go     | 17 +++++++++++++++++
 services/attachment/attachment.go      |  4 +++-
 services/attachment/attachment_test.go | 26 ++++++++++++++++++++++++++
 web_src/js/features/dropzone.test.ts   | 12 ++++++++++++
 web_src/js/features/dropzone.ts        | 10 +++++++++-
 7 files changed, 70 insertions(+), 5 deletions(-)
 create mode 100644 web_src/js/features/dropzone.test.ts

