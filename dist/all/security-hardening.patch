--- /dev/null
+++ b/models/db/page_capacity_test.go
@@ -0,0 +1,56 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package db
+
+import (
+	"io/fs"
+	"os"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func TestPageCapacity(t *testing.T) {
+	assert.Equal(t, 0, PageCapacity(-5))
+	assert.Equal(t, 0, PageCapacity(0))
+	assert.Equal(t, 1, PageCapacity(1))
+	assert.Equal(t, 50, PageCapacity(50))
+	assert.Equal(t, maxPageCapacity, PageCapacity(maxPageCapacity))
+	// a page size from ?limit= or ?n= reserves no more than maxPageCapacity
+	assert.Equal(t, maxPageCapacity, PageCapacity(maxPageCapacity+1))
+	assert.Equal(t, maxPageCapacity, PageCapacity(1_000_000_000))
+}
+
+// Negative test: no result slice anywhere in Gitea takes its capacity from a page
+// size as it is - each goes through PageCapacity.
+func TestNoPageSizeCapacity(t *testing.T) {
+	root := filepath.Join("..", "..")
+	unbounded := regexp.MustCompile(`make\([^()]*,\s*0,\s*[A-Za-z_][\w.]*\.PageSize\)`)
+	var found []string
+	err := filepath.WalkDir(root, func(path string, d fs.DirEntry, err error) error {
+		if err != nil {
+			return err
+		}
+		if d.IsDir() && (d.Name() == "node_modules" || d.Name() == ".git" || d.Name() == "vendor") {
+			return filepath.SkipDir
+		}
+		if d.IsDir() || !strings.HasSuffix(path, ".go") || strings.HasSuffix(path, "_test.go") {
+			return nil
+		}
+		data, err := os.ReadFile(path)
+		if err != nil {
+			return err
+		}
+		for _, m := range unbounded.FindAllString(string(data), -1) {
+			found = append(found, path+": "+m)
+		}
+		return nil
+	})
+	require.NoError(t, err)
+	assert.Empty(t, found)
+}
