--- /dev/null
+++ b/models/auth/twofactor_key_test.go
@@ -0,0 +1,51 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package auth
+
+import (
+	"crypto/md5" //nolint:gosec // the derivation every stored TOTP secret was made with
+	"encoding/base64"
+	"testing"
+	"time"
+
+	"gitea.dev/modules/secret"
+	"gitea.dev/modules/setting"
+	"gitea.dev/modules/test"
+
+	"github.com/pquerna/otp/totp"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// The TOTP key is still MD5(SECRET_KEY): a secret stored before it went through the
+// crypto registry is readable, and one stored now is readable the old way.
+func TestTwoFactorEncryptionKeyUnchanged(t *testing.T) {
+	defer test.MockVariableValue(&setting.SecretKey, "a-secret-key")()
+	old := md5.Sum([]byte(setting.SecretKey))
+	tfa := &TwoFactor{}
+	assert.Equal(t, old[:], tfa.getEncryptionKey())
+
+	const totpSecret = "JBSWY3DPEHPK3PXP"
+	stored, err := secret.AesEncrypt(old[:], []byte(totpSecret))
+	require.NoError(t, err)
+	tfa.Secret = base64.StdEncoding.EncodeToString(stored)
+	code, err := totp.GenerateCode(totpSecret, time.Now())
+	require.NoError(t, err)
+	ok, err := tfa.validateTOTP(code)
+	require.NoError(t, err)
+	assert.True(t, ok)
+
+	require.NoError(t, tfa.SetSecret(totpSecret))
+	raw, err := base64.StdEncoding.DecodeString(tfa.Secret)
+	require.NoError(t, err)
+	plain, err := secret.AesDecrypt(old[:], raw)
+	require.NoError(t, err)
+	assert.Equal(t, totpSecret, string(plain))
+
+	// negative: another SECRET_KEY gives another key, and the stored secret is unreadable
+	defer test.MockVariableValue(&setting.SecretKey, "another-key")()
+	assert.NotEqual(t, old[:], tfa.getEncryptionKey())
+	ok, err = tfa.validateTOTP(code)
+	assert.True(t, err != nil || !ok)
+}
diff --git a/models/db/list.go b/models/db/list.go
index 6d1e89bb8b..1c3979b606 100644
--- a/models/db/list.go
+++ b/models/db/list.go
@@ -24,6 +24,24 @@ type Paginator interface {
 	IsListAll() bool
 }
 
+// maxPageCapacity is the most elements a page's result slice reserves up front.
+const maxPageCapacity = 100
+
+// PageCapacity is the capacity to make a page's result slice with: n, but never
+// more than maxPageCapacity and never negative. A page size can come from the
+// request (?limit=, ?n=) and does not always pass through ListOptions'
+// bounds first, so a capacity taken from it as is could reserve gigabytes before
+// one row is read; append grows the slice when a page really holds more.
+func PageCapacity(n int) int {
+	if n <= 0 {
+		return 0
+	}
+	if n > maxPageCapacity {
+		return maxPageCapacity
+	}
+	return n
+}
+
 // SetSessionPagination sets pagination for a database session
 func SetSessionPagination(sess Engine, p Paginator) {
 	skip, take := p.GetSkipTake()
