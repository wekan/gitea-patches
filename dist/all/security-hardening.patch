@@ -0,0 +1,35 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package git
+
+import (
+	"os"
+	"path/filepath"
+	"testing"
+
+	"gitea.dev/modules/git/gitrepo"
+	"gitea.dev/modules/util"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// GetHook builds the hook's path from its own list of names: a name from the request
+// that is not one of them - a path among them - is refused before any file is read.
+func TestGetHookOnlyKnownNames(t *testing.T) {
+	repoPath := t.TempDir()
+	require.NoError(t, os.MkdirAll(filepath.Join(repoPath, "hooks", "update.d"), 0o755))
+	require.NoError(t, os.WriteFile(filepath.Join(repoPath, "hooks", "update.d", "update"), []byte("#!/bin/sh\n"), 0o755))
+	repo := gitrepo.RepositoryUnmanaged(repoPath)
+
+	h, err := GetHook(repo, "update")
+	require.NoError(t, err)
+	assert.True(t, h.IsActive)
+	assert.Equal(t, "update", h.Name())
+
+	for _, name := range []string{"../config", "update/../../x", "/etc/passwd", "Update", "", "pre-commit"} {
+		_, err := GetHook(repo, name)
+		assert.ErrorIs(t, err, util.ErrNotExist, name)
+	}
+}
