@@ -0,0 +1,39 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package issues_test
+
+import (
+	"testing"
+
+	issues_model "gitea.dev/models/issues"
+	"gitea.dev/models/unittest"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"xorm.io/builder"
+)
+
+// The dashboard's milestone counts filter by name case-insensitively, the keyword a
+// bound value of the query: SQL in it is matched as text, never run.
+func TestGetMilestonesStatsByRepoCondAndKwKeyword(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	repo1 := builder.Eq{"id": 1}
+
+	stats, err := issues_model.GetMilestonesStatsByRepoCondAndKw(t.Context(), repo1, "MILESTONE")
+	require.NoError(t, err)
+	assert.EqualValues(t, 2, stats.OpenCount) // milestone1, milestone2
+	assert.EqualValues(t, 1, stats.ClosedCount)
+
+	stats, err = issues_model.GetMilestonesStatsByRepoCondAndKw(t.Context(), repo1, "stone3")
+	require.NoError(t, err)
+	assert.EqualValues(t, 0, stats.OpenCount)
+	assert.EqualValues(t, 1, stats.ClosedCount)
+
+	for _, kw := range []string{"' OR '1'='1", "x%') OR 1=1 --", "milestone1'; DROP TABLE milestone; --"} {
+		stats, err = issues_model.GetMilestonesStatsByRepoCondAndKw(t.Context(), repo1, kw)
+		require.NoError(t, err, kw)
+		assert.EqualValues(t, 0, stats.Total(), kw)
+	}
+	unittest.AssertExistsAndLoadBean(t, &issues_model.Milestone{ID: 1})
+}
