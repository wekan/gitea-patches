+
+// A session ID that is not a plain name inside rootPath never reaches the file system:
+// load, save and destroy refuse it before a path is built, and nothing outside rootPath
+// is read, created or removed.
+func TestFileBackendRefusesPathsOutsideRoot(t *testing.T) {
+	parent := t.TempDir()
+	root := filepath.Join(parent, "sessions")
+	backend := newFileBackend(root, 3600)
+	outside := filepath.Join(parent, "outside")
+	require.NoError(t, os.WriteFile(outside, []byte("not a session"), 0o600))
+
+	for _, sid := range []string{"", "a", "..", "../outside", "ab/../../outside", "/etc/passwd", outside} {
+		_, err := backend.load(sid)
+		assert.ErrorIs(t, err, errSessionFileName, sid)
+		assert.ErrorIs(t, backend.save(sid, []byte("x"), true), errSessionFileName, sid)
+		assert.ErrorIs(t, backend.destroy(sid), errSessionFileName, sid)
+	}
+	data, err := os.ReadFile(outside)
+	require.NoError(t, err)
+	assert.Equal(t, "not a session", string(data))
+	assert.NoDirExists(t, root)
+
+	sid := newSessionID() // a real session ID still works
+	require.NoError(t, backend.save(sid, []byte("ok"), true))
+	encoded, err := backend.load(sid)
+	require.NoError(t, err)
+	assert.Equal(t, "ok", string(encoded))
+	require.NoError(t, backend.destroy(sid))
+}
