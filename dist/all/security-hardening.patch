+package actions
+
+import (
+	"testing"
+
+	"gitea.dev/models/unittest"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+// A step summary is inserted, then replaced in place; the runner's content is a bound
+// value of the statement, so SQL in it is stored as text.
+func TestUpsertActionRunJobSummary(t *testing.T) {
+	require.NoError(t, unittest.PrepareTestDatabase())
+	ctx := t.Context()
+
+	require.NoError(t, UpsertActionRunJobSummary(ctx, 1, 2, 3, 4, 0, JobSummaryContentTypeMarkdown, []byte("# first")))
+	s, err := GetActionRunJobSummary(ctx, 1, 2, 3, 4, 0)
+	require.NoError(t, err)
+	assert.Equal(t, "# first", s.Content)
+
+	evil := "'); DELETE FROM action_run_job_summary; --"
+	require.NoError(t, UpsertActionRunJobSummary(ctx, 1, 2, 3, 4, 0, JobSummaryContentTypeMarkdown, []byte(evil)))
+	s, err = GetActionRunJobSummary(ctx, 1, 2, 3, 4, 0)
+	require.NoError(t, err)
+	assert.Equal(t, evil, s.Content)
+	assert.EqualValues(t, len(evil), s.ContentSize)
+
+	list, err := ListActionRunJobSummaries(ctx, 1, 2, 3, 0)
+	require.NoError(t, err)
+	assert.Len(t, list, 1)
+}
