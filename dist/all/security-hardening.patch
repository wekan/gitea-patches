new file mode 100644
index 0000000000..1ae42acea2
--- /dev/null
+++ b/services/context/access_log_redact_test.go
@@ -0,0 +1,66 @@
+// Copyright 2026 The Gitea Authors. All rights reserved.
+// SPDX-License-Identifier: MIT
+
+package context
+
+import (
+	"math"
+	"net/http/httptest"
+	"strings"
+	"testing"
+
+	"gitea.dev/modules/setting"
+	"gitea.dev/modules/test"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestRedactedRequest(t *testing.T) {
+	req := httptest.NewRequest("GET", "/api/v1/repos?token=secret-token&page=2&access_token=other-secret", nil)
+	req.Header.Set("Authorization", "token secret-header")
+	req.Header.Set("Cookie", "i_like_gitea=secret-cookie")
+	req.Header.Set("Accept", "application/json")
+
+	r := redactedRequest(req)
+	logged := r.URL.String() + " " + r.RequestURI + " " + strings.Join(r.Header.Values("Authorization"), ",") + " " + r.Header.Get("Cookie")
+	for _, secret := range []string{"secret-token", "other-secret", "secret-header", "secret-cookie"} {
+		assert.NotContains(t, logged, secret)
+	}
+	assert.Equal(t, "2", r.URL.Query().Get("page"), "other query parameters stay")
+	assert.Equal(t, "application/json", r.Header.Get("Accept"), "other headers stay")
+
+	// The request itself is not changed: the handler that runs next still has it.
+	assert.Equal(t, "secret-token", req.URL.Query().Get("token"))
+	assert.Equal(t, "token secret-header", req.Header.Get("Authorization"))
+
+	// A request without credentials is logged as it is.
+	plain := httptest.NewRequest("GET", "/explore/repos?q=gitea", nil)
+	assert.Same(t, plain, redactedRequest(plain))
+}
+
+func TestRequestIDNeverACredential(t *testing.T) {
+	defer test.MockVariableValue(&setting.Log.RequestIDHeaders, []string{"authorization", "Cookie", "X-Request-ID"})()
+	req := httptest.NewRequest("GET", "/", nil)
+	req.Header.Set("Authorization", "token secret-header")
+	req.Header.Set("Cookie", "i_like_gitea=secret-cookie")
+	assert.Equal(t, "-", parseRequestIDFromRequestHeader(req), "a credential header is never the request ID")
+
+	req.Header.Set("X-Request-ID", "req-123")
+	assert.Equal(t, "req-123", parseRequestIDFromRequestHeader(req), "the next configured header is used")
+
+	assert.Empty(t, redactCredentialHeader("proxy-authorization", "Basic abc"))
+	assert.Equal(t, "abc", redactCredentialHeader("X-Trace-Id", "abc"))
+}
+
+// A total beyond the 32-bit range is clamped, not wrapped, and -1 ("only prev/next")
+// is kept.
+func TestTotalToInt(t *testing.T) {
+	assert.Equal(t, 0, totalToInt(0))
+	assert.Equal(t, -1, totalToInt(-1))
+	assert.Equal(t, 12345, totalToInt(12345))
+	assert.Equal(t, math.MaxInt32, totalToInt(math.MaxInt32))
+	assert.Equal(t, math.MaxInt32, totalToInt(math.MaxInt32+1))
+	assert.Equal(t, math.MaxInt32, totalToInt(math.MaxInt64))
+	assert.Equal(t, math.MinInt32, totalToInt(math.MinInt64))
+	assert.Positive(t, newPagination(math.MaxInt64, 20, 1, 5).Paginator.TotalPages())
+}
